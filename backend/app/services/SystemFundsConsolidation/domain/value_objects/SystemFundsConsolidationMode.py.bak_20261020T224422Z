from enum import Enum


class SystemFundsConsolidationMode(str, Enum):
    MANY_TO_ONE = "MANY_TO_ONE"
    ONE_TO_MANY = "ONE_TO_MANY"
    VIRTUAL_MANY_TO_ONE = "VIRTUAL_MANY_TO_ONE"

    @classmethod
    def parse(cls, value: str | SystemFundsConsolidationMode) -> SystemFundsConsolidationMode:
        if isinstance(value, cls):
            return value
        try:
            return cls(value)
        except ValueError as exc:
            allowed = ", ".join(mode.value for mode in cls)
            raise ValueError(
                f"Unsupported system funds consolidation mode: {value!r}. "
                f"Allowed modes: {allowed}."
            ) from exc
